# REG.RU / static hosting deployment
#
# Build locally or in the hosting build step:
#   npm ci
#   npm run build
#
# Upload the contents of dist/ to the hosting document root (usually www/).
# The VITE_* variables must be set during the build, not after it.
#
# Required variables:
#   VITE_SUPABASE_URL=https://dydsgyjwjbrcymkvzrji.supabase.co
#   VITE_SUPABASE_ANON_KEY=<Supabase Publishable/anon public key>
